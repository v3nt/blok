<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.jynk.blokscrape</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/danielcrabbe14/Sites/jynk/blok/scraper/refresh.sh</string>
    </array>

    <!--
      Fixed times, not StartInterval. A laptop that sleeps through an interval
      simply loses it: launchd does not queue up missed StartInterval firings,
      which is how this job went from 00:00 to midday without running once.
      StartCalendarInterval fires as soon as the machine is awake past a
      scheduled time, so a missed slot is picked up rather than skipped.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/danielcrabbe14/Sites/jynk/blok/scraper/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielcrabbe14/Sites/jynk/blok/scraper/refresh.log</string>
</dict>
</plist>
