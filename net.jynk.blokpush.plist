<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.jynk.blokpush</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Run through bash, so the job never depends on the script's
             executable bit (losing it stopped all pushes on 9 Oct). -->
        <string>/bin/bash</string>
        <string>/Users/danielcrabbe14/Sites/jynk/blok/push-blok.sh</string>
    </array>

    <!-- Every 10 minutes: check BLOK emails for bookings, then commit + push. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/danielcrabbe14/Sites/jynk/blok/push-blok.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/danielcrabbe14/Sites/jynk/blok/push-blok.log</string>
</dict>
</plist>
